    "crawl": "node ./dist/scripts/crawl.js",
    "analyse": "node ./dist/scripts/analyse.js",
    "generate": "node ./dist/scripts/generate.js",
    "setup": "node ./dist/scripts/setup.js"
  },
  "dependencies": {
    "change-case": "^5.4.2",
    "colors": "^1.4.0",
    "concat-files": "^0.1.1",
    "crawler": "^1.5.0",
    "ejs": "^3.1.9",
    "events": "^3.3.0",
    "glob": "^8.0.3",
    "inquirer": "^9.2.12",
    "puppeteer": "^24",
    "puppeteer-autoscroll-down": "^1.1.2",
    "yargs": "^17.6.0"
  },
  "devDependencies": {
    "@shopify/eslint-plugin": "^50.0.0",
    "@types/node": "^18.8.3",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "nodemon": "^2.0.20",
    "prettier": "^3.6.2",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4"
