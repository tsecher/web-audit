{
  "name": "web_audit",
  "version": "5.0.0-rc6",
  "description": "Web audit tools",
  "main": "dist/index",
  "typings": "dist/index",
  "repository": "git@bitbucket.org:thomasse/quality_audit.git",
  "author": "tsecher <me@thomas-secher.fr>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "analyse": "bin/analyse.js",
    "crawl": "bin/crawl.js",
    "generate": "bin/generate.js",
    "setup": "bin/setup.js"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf ./build && tsc",
    "lint": "eslint . --ext .ts",
